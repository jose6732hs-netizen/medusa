# Variáveis de Ambiente Obrigatórias - Medusa

## Database
DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL_UNPOOLED=postgresql://[user]:[password]@[host]:[port]/[database]?schema=public

## Environment
NODE_ENV=development

## Security - Gerar valores aleatórios e seguros
JWT_SECRET=your-secret-jwt-key-change-me
COOKIE_SECRET=your-secret-cookie-key-change-me

## CORS Configuration
ADMIN_CORS=http://localhost:7001,http://localhost:7002
STORE_CORS=http://localhost:3000,http://localhost:8000

## File Service
FILE_SERVICE_LOCAL_URL=http://localhost:9000

## Server Port
PORT=9000

## Optional - Redis (para cache e sessions)
# REDIS_URL=redis://localhost:6379

## Optional - Logging
LOG_LEVEL=info

## Optional - Telemetry
# ANONYMIZED_TELEMETRY=true
