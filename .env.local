# ===================================
# ENVIRONMENT
# ===================================
NODE_ENV=development

# ===================================
# SECRETS - Para produção, gere novos valores seguros
# ===================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars-long-value
COOKIE_SECRET=your-super-secret-cookie-key-change-in-production-long-value

# ===================================
# CORS Configuration
# ===================================
ADMIN_CORS=http://localhost:7001,http://localhost:7002,http://localhost:3000
STORE_CORS=http://localhost:3000,http://localhost:8000,http://localhost:3001

# ===================================
# FILE SERVICE
# ===================================
FILE_SERVICE_LOCAL_URL=http://localhost:9000

# ===================================
# SERVER PORT
# ===================================
PORT=9000

# ===================================
# OPTIONAL: API URLs (for external services)
# ===================================
NEXT_PUBLIC_API_URL=http://localhost:9000
NEXT_PUBLIC_UI_URL=http://localhost:3000

# ===================================
# OPTIONAL: Analytics & Telemetry
# Set to 'dummy' para usar valores placeholder
# ===================================
POSTHOG_API_KEY=dummy
POSTHOG_ENDPOINT=dummy

# ===================================
# OPTIONAL: File Storage (S3)
# Para desenvolvimento local, deixe em branco ou use valores dummy
# ===================================
S3_BUCKET=dummy
S3_REGION=dummy
S3_ACCESS_KEY_ID=dummy
S3_SECRET_ACCESS_KEY=dummy

# ===================================
# OPTIONAL: Payment Providers
# Para desenvolvimento local, use valores dummy
# ===================================
STRIPE_API_KEY=dummy
STRIPE_WEBHOOK_SECRET=dummy

# ===================================
# OPTIONAL: Third-party Services
# ===================================
ALGOLIA_APP_ID=dummy
ALGOLIA_API_KEY=dummy
CLOUDINARY_NAME=dummy
CLOUDINARY_API_KEY=dummy
