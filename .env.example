# Medusa Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ===================================
# REQUIRED: Database Configuration
# ===================================
# PostgreSQL connection string (Neon, Amazon RDS, local, etc)
DATABASE_URL=postgresql://user:password@host:5432/medusa

# Unpooled connection for migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/medusa

# ===================================
# REQUIRED: Environment
# ===================================
# production | development | test
NODE_ENV=development

# ===================================
# REQUIRED: Security Secrets
# ===================================
# JWT token secret - min 32 chars, strong random value
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-random-value

# Cookie secret - min 32 chars, strong random value  
COOKIE_SECRET=your-super-secret-cookie-key-min-32-characters-long-random-value

# ===================================
# CORS Configuration
# ===================================
# Admin panel URLs allowed
ADMIN_CORS=http://localhost:7001,http://localhost:7002

# Store URLs allowed
STORE_CORS=http://localhost:3000,http://localhost:8000

# ===================================
# File Storage
# ===================================
# Local file service URL
FILE_SERVICE_LOCAL_URL=http://localhost:9000

# ===================================
# Server Configuration
# ===================================
# Port to run Medusa server
PORT=9000

# ===================================
# OPTIONAL: Frontend URLs
# ===================================
NEXT_PUBLIC_API_URL=http://localhost:9000
NEXT_PUBLIC_UI_URL=http://localhost:3000

# ===================================
# OPTIONAL: Analytics
# ===================================
POSTHOG_API_KEY=
POSTHOG_ENDPOINT=

# ===================================
# OPTIONAL: S3 File Storage
# ===================================
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ===================================
# OPTIONAL: Stripe Payment
# ===================================
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ===================================
# OPTIONAL: Third-party Services
# ===================================
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
