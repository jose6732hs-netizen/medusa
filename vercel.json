{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url",
    "JWT_SECRET": "@jwt_secret",
    "COOKIE_SECRET": "@cookie_secret",
    "BACKEND_URL": "@backend_url",
    "STORE_CORS": "@store_cors",
    "ADMIN_CORS": "@admin_cors",
    "AUTH_CORS": "@auth_cors",
    "NODE_ENV": "production"
  },
  "regions": ["sfo1"]
}
