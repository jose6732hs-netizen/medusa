# Database - Neon PostgreSQL
# Obtenha em: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.neon.tech/medusa_ecommerce?sslmode=require

# NextAuth - Autenticação
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres
NEXTAUTH_URL=http://localhost:3000

# Stripe - Pagamentos
# Obtenha em: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_seu_chave_publica
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret

# Ambiente
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
