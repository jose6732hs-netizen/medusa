# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string (Neon)
# Exemplo: postgresql://user:password@region.neon.tech/database?sslmode=require
DATABASE_URL=

# ============================================
# AUTHENTICATION SECRETS
# ============================================
# JWT Secret - gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cookie Secret - gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# ============================================
# SERVER CONFIGURATION
# ============================================
# Porta do servidor backend Medusa
PORT=3000

# URL publica do backend (para CORS)
BACKEND_URL=http://localhost:3000

# ============================================
# CORS CONFIGURATION
# ============================================
# URLs permitidas para chamadas CORS (separadas por virgula)
# Exemplo: http://localhost:3001,https://seu-frontend.com
STORE_CORS=http://localhost:3001

# URLs permitidas para o painel admin
ADMIN_CORS=http://localhost:3002

# URLs permitidas para servicos de autenticacao
AUTH_CORS=http://localhost:3000

# ============================================
# MULTI-TENANT / SUPER ADMIN
# ============================================
# URL da super admin dashboard (seu painel para gerenciar tenants)
SUPER_ADMIN_URL=http://localhost:3002

# Email do super admin (primeiro usuario a ser criado)
SUPER_ADMIN_EMAIL=admin@seu-saas.com

# Senha temporaria do super admin (mude apos primeiro login)
SUPER_ADMIN_PASSWORD=ChangeMe123!

# ============================================
# OPTIONAL - EMAIL SERVICE (para verificacao, recuperacao de senha, etc)
# ============================================
# SMTP_HOST=smtp.seu-email.com
# SMTP_PORT=587
# SMTP_USER=seu-email@seu-dominio.com
# SMTP_PASSWORD=sua-senha-app
# SMTP_FROM=noreply@seu-saas.com

# ============================================
# OPTIONAL - FILE STORAGE (para uploads de produtos, logos, etc)
# ============================================
# USE_MINIO=true
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
